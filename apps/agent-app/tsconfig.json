{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsxImportSource": "nativewind",
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "src/components/customer",
    "src/components/seller"
  ]
}
